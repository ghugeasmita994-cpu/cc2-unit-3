
#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

int main() 
{
    int n = 5;

    vector<pair<int, int>> graph[5];

    graph[0].push_back({1, 60});
    graph[0].push_back({2, 120});
    graph[1].push_back({2, 40});
    graph[1].push_back({3, 100});
    graph[2].push_back({3, 50});
    graph[2].push_back({4, 80});
    graph[3].push_back({4, 30});

    string airports[] = 
{
        "Mumbai", "Pune", "Delhi",
        "Chennai", "Bengaluru"
    };

    int dist[5];

    for (int i = 0; i < n; i++)
        dist[i] = INT_MAX;

    priority_queue<pair<int, int>,
        vector<pair<int, int>>,
        greater<pair<int, int>>> pq;

    dist[0] = 0;
    pq.push({0, 0});

    while (!pq.empty()) 
{
        int u = pq.top().second;
        pq.pop();

        for (auto edge : graph[u]) 
{
            int v = edge.first;
            int w = edge.second;

            if (dist[u] + w < dist[v]) 
{
                dist[v] = dist[u] + w;
                pq.push({dist[v], v});
            }
        }
    }

    cout << "Airport Network - Dijkstra Algorithm\n";

    for (int i = 0; i < n; i++) 
{
        cout << airports[i] << " : "
             << dist[i] << " minutes" << endl;
    }

    return 0;
}
