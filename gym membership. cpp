// Display Members
void displayMembers() 
{
    Member* temp = head;

    if (temp == NULL) 
{
        cout << "No Members Found!\n";
        return;
    }

    cout << "\n--- Member Records ---\n";

    while (temp != NULL) 
{
        cout << "\nMember ID: " << temp->id;
        cout << "\nName: " << temp->name;
        cout << "\nMembership Months: " << temp->months << "\n";
        temp = temp->next;
    }
}

// Search Member
void searchMember() 
{
    int id;
    cout << "Enter Member ID to Search: ";
    cin >> id;

    Member* temp = head;

    while (temp != NULL) 
{
        if (temp->id == id) 
{
            cout << "\nMember Found!\n";
            cout << "ID: " << temp->id << "\n";
            cout << "Name: " << temp->name << "\n";
            cout << "Months: " << temp->months << "\n";
            return;
        }
        temp = temp->next;
    }

    cout << "Member Not Found!\n";
}

// Renew Membership
void renewMembership() 
{
    int id, extraMonths;

    cout << "Enter Member ID: ";
    cin >> id;

    Member* temp = head;

    while (temp != NULL) 
{
        if (temp->id == id) 
{
            cout << "Enter Extra Months: ";
            cin >> extraMonths;

            if (extraMonths <= 0) 
{
                cout << "Enter a positive number of months!\n";
                return;
            }

            temp->months += extraMonths;
            cout << "Membership Renewed Successfully!\n";
            cout << "Total Months: " << temp->months << "\n";
            return;
        }
        temp = temp->next;
    }

    cout << "Member Not Found!\n";
}

// Delete Member
void deleteMember() 
{
    int id;
    cout << "Enter Member ID to Delete: ";
    cin >> id;

    Member* temp = head;
    Member* prev = NULL;

    while (temp != NULL) 
{
        if (temp->id == id) 
{
            if (prev == NULL) 
{
                head = temp->next;
            } else {
                prev->next = temp->next;
            }

            delete temp;
            cout << "Member Deleted Successfully!\n";
            return;
        }

        prev = temp;
        temp = temp->next;
    }

    cout << "Member Not Found!\n";
}

