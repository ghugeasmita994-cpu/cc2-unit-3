        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) 
{
            case 1:
                addMember();
                break;

            case 2:
                displayMembers();
                break;

            case 3:
                searchMember();
                break;

            case 4:
                renewMembership();
                break;

            case 5:
                deleteMember();
                break;

            case 6:
                cout << "Thank You!\n";
                break;

            default:
                cout << "Invalid Choice! Try Again.\n";
        }

    } while (choice != 6);

    // Free allocated memory
    while (head != NULL) 
{
        Member* temp = head;
        head = head->next;
        delete temp;
    }

    return 0;
}
